{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build",
      "type": "process",
      "command": "dotnet",
      "args": ["build"],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Publish Release",
      "type": "process",
      "command": "dotnet",
      "args": ["publish", "-c", "Release"],
      "problemMatcher": "$msCompile",
      "group": "build"
    }
  ]
}
