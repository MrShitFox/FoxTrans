<Project>

  <Target Name="BuildFoxTransNative"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' != 'true' And '$(MSBuildProjectName)' == 'FoxTrans'">
    <Error Condition="'$(FoxTransNativeRid)' != '$(FoxTransNativeHostRid)'"
           Text="FoxTrans native assets must be built on a matching host. Build $(FoxTransNativeRid) on a $(FoxTransNativeRid) runner." />
    <Error Condition="'$(FoxTransNativeFileName)' == ''"
           Text="FoxTrans supports native publishing only for win-x64 and linux-x64." />
    <Exec Command="&quot;$(FoxTransCmakeCommand)&quot; -S &quot;$(MSBuildThisFileDirectory)native&quot; -B &quot;$(FoxTransNativeBuildDirectory)&quot; -DCMAKE_BUILD_TYPE=$(Configuration)" />
    <Exec Command="&quot;$(FoxTransCmakeCommand)&quot; --build &quot;$(FoxTransNativeBuildDirectory)&quot; --config $(Configuration)" />
  </Target>

  <Target Name="CopyFoxTransNative"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="BuildFoxTransNative"
          Condition="Exists('$(FoxTransNativeOutputPath)')">
    <Copy SourceFiles="$(FoxTransNativeOutputPath)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BundleFoxTransNative"
          BeforeTargets="_ComputeFilesToBundle"
          DependsOnTargets="BuildFoxTransNative"
          Condition="Exists('$(FoxTransNativeOutputPath)')">
    <ItemGroup>
      <ResolvedFileToPublish Include="$(FoxTransNativeOutputPath)">
        <RelativePath>$(FoxTransNativeFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <Target Name="ExcludeReleaseCopyLocalSymbols"
          AfterTargets="ResolveReferences"
          BeforeTargets="CopyFilesToOutputDirectory"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ReferenceCopyLocalPaths
          Remove="@(ReferenceCopyLocalPaths)"
          Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.pdb'" />
      <RuntimeCopyLocalItems
          Remove="@(RuntimeCopyLocalItems)"
          Condition="'%(RuntimeCopyLocalItems.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <Target Name="ExcludeReleasePublishSymbols"
          BeforeTargets="_ComputeResolvedFilesToPublishTypes"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish
          Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
