<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FoxTrans.Core</AssemblyName>
    <PackageId>FoxTrans.Core</PackageId>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <!-- The package's build target copies all architectures after Publish. Add only the win-x64 DLL before bundling. -->
    <PackageReference Include="WebRtcVadSharp" Version="1.3.2" ExcludeAssets="build" GeneratePathProperty="true" />
  </ItemGroup>

</Project>
