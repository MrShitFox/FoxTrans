<UserControl
    x:Class="FoxTrans.Desktop.Views.CredentialEditorView"
    x:DataType="vm:CredentialEditorViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FoxTrans.Desktop.ViewModels">
  <StackPanel Spacing="9">
    <Border Classes="segmented">
      <Grid ColumnDefinitions="*,*">
        <RadioButton Grid.Column="0"
                     Classes="segment first"
                     IsChecked="{Binding EnvironmentModeSelected}"
                     Content="Environment variable" />
        <RadioButton Grid.Column="1"
                     Classes="segment last"
                     IsChecked="{Binding InlineModeSelected}"
                     Content="Inline value" />
      </Grid>
    </Border>

    <StackPanel IsVisible="{Binding UsesEnvironmentVariable}"
                Spacing="7">
      <TextBlock Classes="fieldLabel"
                 Text="Variable name" />
      <Grid ColumnDefinitions="Auto,*">
        <Border Classes="fieldPrefix">
          <TextBlock Classes="secondary"
                     VerticalAlignment="Center"
                     Text="env:" />
        </Border>
        <TextBox Grid.Column="1"
                 Classes="joinedField"
                 Text="{Binding EnvironmentVariable}" />
      </Grid>
    </StackPanel>

    <StackPanel IsVisible="{Binding UsesInlineValue}"
                Spacing="7">
      <TextBlock Classes="fieldLabel"
                 Text="Credential" />
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="8">
        <TextBox IsVisible="{Binding IsMasked}"
                 PasswordChar="●"
                 Text="{Binding InlineValue}" />
        <TextBox IsVisible="{Binding IsRevealed}"
                 Text="{Binding InlineValue}" />
        <ToggleButton Grid.Column="1"
                      Classes="quiet"
                      MinWidth="86"
                      VerticalAlignment="Stretch"
                      IsChecked="{Binding IsRevealed}"
                      Content="{Binding RevealActionText}" />
      </Grid>
      <TextBlock Classes="warningText"
                 Text="Stored as plain text in config.jsonc."
                 TextWrapping="Wrap" />
    </StackPanel>

    <TextBlock Classes="validation animated"
               Classes.visible="{Binding HasError}"
               Text="{Binding Error}"
               TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
