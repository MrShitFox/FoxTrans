<UserControl
    x:Class="FoxTrans.Desktop.Views.PipelinePageView"
    x:DataType="vm:PipelinePageViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FoxTrans.Desktop.ViewModels"
    xmlns:views="using:FoxTrans.Desktop.Views">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="{DynamicResource Space.Page}" Spacing="16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="4">
          <TextBlock FontSize="26"
                     FontWeight="SemiBold"
                     Text="Pipeline" />
          <TextBlock Classes="secondary"
                     Text="Inspect the effective topology and resolved non-secret configuration." />
        </StackPanel>
        <Button Grid.Column="1"
                Command="{Binding OpenFolderCommand}"
                Content="Open config folder" />
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="3">
              <TextBlock Classes="eyebrow" Text="CURRENT TOPOLOGY" />
              <TextBlock FontSize="17"
                         FontWeight="SemiBold"
                         Text="{Binding Title}" />
            </StackPanel>
            <Border Grid.Column="1"
                    Padding="10,5"
                    CornerRadius="9"
                    Background="{DynamicResource Brush.SurfaceElevated}">
              <TextBlock FontSize="11"
                         Text="Inspection only" />
            </Border>
          </Grid>
          <views:PipelineFlowView DataContext="{Binding}" />
        </StackPanel>
      </Border>

      <Border Classes="card"
              BorderBrush="{DynamicResource Brush.Error}"
              IsVisible="{Binding HasProblems}">
        <StackPanel Spacing="10">
          <TextBlock FontSize="16"
                     FontWeight="SemiBold"
                     Text="Configuration problems" />
          <ItemsControl ItemsSource="{Binding Problems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ConfigIssueViewModel">
                <StackPanel Margin="0,4" Spacing="2">
                  <TextBlock FontWeight="SemiBold" Text="{Binding Path}" />
                  <TextBlock Classes="secondary"
                             Text="{Binding Message}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="eyebrow" Text="EFFECTIVE CONFIGURATION" />
          <TextBlock Classes="secondary"
                     FontSize="11"
                     Text="{Binding ConfigPath}"
                     TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding EffectiveSettings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EffectiveSettingViewModel">
                <Grid Margin="0,5"
                      ColumnDefinitions="150,180,*"
                      ColumnSpacing="12">
                  <TextBlock Classes="secondary" Text="{Binding Stage}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}" />
                  <TextBlock Grid.Column="2"
                             Classes="secondary"
                             Text="{Binding Value}"
                             TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Background="{DynamicResource Brush.SurfaceElevated}"
              BorderBrush="{DynamicResource Brush.Border}"
              BorderThickness="1"
              CornerRadius="14"
              Padding="16">
        <TextBlock Classes="secondary"
                   Text="Visual pipeline editing arrives in the next product session. This page deliberately does not offer controls that cannot save a complete typed configuration."
                   TextWrapping="Wrap" />
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
