<Window
    x:Class="FoxTrans.Desktop.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FoxTrans.Desktop.ViewModels"
    xmlns:views="using:FoxTrans.Desktop.Views"
    Title="FoxTrans"
    Width="1180"
    Height="760"
    MinWidth="960"
    MinHeight="640"
    WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="104,*" RowDefinitions="76,*">
    <Border Grid.RowSpan="2"
            Grid.Column="0"
            Background="{DynamicResource Brush.Rail}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="76,*,Auto">
        <Border Width="42"
                Height="42"
                CornerRadius="14"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
          <Border.Background>
            <LinearGradientBrush StartPoint="0%,0%"
                                 EndPoint="100%,100%">
              <GradientStop Color="{DynamicResource Color.AccentSecondary}" Offset="0" />
              <GradientStop Color="{DynamicResource Color.Accent}" Offset="1" />
            </LinearGradientBrush>
          </Border.Background>
          <TextBlock HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     FontSize="14"
                     FontWeight="Bold"
                     Foreground="#F7F6F2"
                     Text="FT" />
        </Border>
        <StackPanel Grid.Row="1"
                    Margin="10,20"
                    Spacing="8">
          <Button Classes="nav"
                  Classes.selected="{Binding IsLiveSelected}"
                  Command="{Binding NavigateLiveCommand}"
                  Content="Live" />
          <Button Classes="nav"
                  Classes.selected="{Binding IsPipelineSelected}"
                  Command="{Binding NavigatePipelineCommand}"
                  Content="Pipeline" />
          <Button Classes="nav"
                  Classes.selected="{Binding IsSettingsSelected}"
                  Command="{Binding NavigateSettingsCommand}"
                  Content="Settings" />
        </StackPanel>
        <TextBlock Grid.Row="2"
                   Classes="muted"
                   Margin="0,0,0,18"
                   HorizontalAlignment="Center"
                   FontSize="10"
                   Text="8.0" />
      </Grid>
    </Border>

    <Border Grid.Column="1"
            Grid.Row="0"
            Background="{DynamicResource Brush.AppBackground}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,0,0,1"
            Padding="28,0">
      <Grid ColumnDefinitions="*,Auto"
            VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="14">
          <TextBlock FontSize="18"
                     FontWeight="SemiBold"
                     Text="FoxTrans" />
          <Border Width="1"
                  Height="18"
                  Background="{DynamicResource Brush.Border}" />
          <StackPanel Spacing="1">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="7"
                       Height="7"
                       VerticalAlignment="Center"
                       Fill="{DynamicResource Brush.AccentSecondary}" />
              <TextBlock FontSize="12"
                         FontWeight="SemiBold"
                         Text="{Binding RuntimeStateText}" />
            </StackPanel>
            <TextBlock Classes="muted"
                       FontSize="10"
                       MaxWidth="520"
                       Text="{Binding PipelineName}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </StackPanel>
        <Button Grid.Column="1"
                Classes="primary"
                MinWidth="112"
                Command="{Binding ToggleRuntimeCommand}"
                Content="{Binding PrimaryActionText}" />
      </Grid>
    </Border>

    <Grid Grid.Column="1"
          Grid.Row="1"
          ClipToBounds="True">
      <Panel IsVisible="{Binding IsLiveSelected}">
        <views:LiveStudioView DataContext="{Binding Live}" />
      </Panel>
      <Panel IsVisible="{Binding IsPipelineSelected}">
        <views:PipelinePageView DataContext="{Binding Pipeline}" />
      </Panel>
      <Panel IsVisible="{Binding IsSettingsSelected}">
        <views:SettingsView DataContext="{Binding Settings}" />
      </Panel>

      <Border Classes.error="{Binding NotificationIsError}"
              IsVisible="{Binding HasNotification}"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Width="390"
              Margin="24"
              Padding="16"
              CornerRadius="14"
              Background="{DynamicResource Brush.SurfaceElevated}"
              BorderBrush="{DynamicResource Brush.Warning}"
              BorderThickness="1"
              BoxShadow="{DynamicResource Shadow.Surface}">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4">
            <TextBlock FontWeight="SemiBold"
                       Text="{Binding NotificationTitle}" />
            <TextBlock Classes="secondary"
                       FontSize="12"
                       Text="{Binding NotificationDetail}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  Classes="nav"
                  MinWidth="34"
                  MinHeight="34"
                  Padding="7"
                  Command="{Binding DismissNotificationCommand}"
                  Content="×" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
