<Window
    x:Class="FoxTrans.Desktop.Views.MainWindow"
    x:Name="Root"
    x:DataType="vm:MainWindowViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FoxTrans.Desktop.ViewModels"
    xmlns:views="using:FoxTrans.Desktop.Views"
    Title="FoxTrans Desktop"
    Width="1180"
    Height="760"
    MinWidth="900"
    MinHeight="620"
    CanResize="True"
    WindowDecorations="None"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    WindowStartupLocation="CenterScreen">
  <Border x:Name="WindowSurface"
          Background="{DynamicResource Brush.AppBackground}"
          CornerRadius="14"
          ClipToBounds="True">
    <Grid RowDefinitions="76,*"
          Background="{DynamicResource Brush.AppBackground}">
    <Grid x:Name="TitleBar"
          Grid.Row="0"
          ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto"
          Background="{DynamicResource Brush.AppBackground}"
          PointerPressed="OnTitleBarPointerPressed">
      <StackPanel x:Name="HeaderIdentity"
                  Grid.Column="0"
                  Margin="22,16,18,0"
                  MaxWidth="600"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Top"
                  Spacing="1">
        <TextBlock x:Name="BrandTitle"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Text="FoxTrans Desktop" />
        <TextBlock Classes="secondary"
                   FontSize="12.5"
                   FontWeight="Medium"
                   Text="{Binding PipelineName}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="muted"
                   FontSize="10.5"
                   MaxWidth="560"
                   Text="{Binding ModelLine}"
                   TextTrimming="CharacterEllipsis" />
      </StackPanel>

      <Button Grid.Column="1"
              Classes="headerAction quiet"
              Margin="5,0"
              VerticalAlignment="Center"
              Command="{Binding OpenSettingsCommand}"
              Content="Settings" />
      <Button x:Name="PrimaryActionButton"
              Grid.Column="2"
              Classes="primary headerAction primaryAction"
              Margin="4,0,10,0"
              VerticalAlignment="Center"
              Command="{Binding ToggleRuntimeCommand}"
              Content="{Binding PrimaryActionText}" />

      <Button x:Name="MinimizeButton"
              Grid.Column="3"
              Classes="windowControl"
              Click="OnMinimizeClick"
              ToolTip.Tip="Minimize">
        <Path Width="11"
              Height="11"
              Stretch="None"
              Stroke="{DynamicResource Brush.TextSecondary}"
              StrokeThickness="1.2"
              Data="M 0,5.5 L 11,5.5" />
      </Button>
      <Button x:Name="MaximizeButton"
              Grid.Column="4"
              Classes="windowControl"
              Click="OnMaximizeClick"
              ToolTip.Tip="Maximize">
        <Grid Width="12" Height="12">
          <Path x:Name="MaximizeGlyph"
                Stretch="None"
                Stroke="{DynamicResource Brush.TextSecondary}"
                StrokeThickness="1.15"
                Data="M 1,1 L 11,1 L 11,11 L 1,11 Z" />
          <Path x:Name="RestoreGlyph"
                IsVisible="False"
                Stretch="None"
                Stroke="{DynamicResource Brush.TextSecondary}"
                StrokeThickness="1.15"
                Data="M 3,1 L 11,1 L 11,9 M 1,3 L 9,3 L 9,11 L 1,11 Z" />
        </Grid>
      </Button>
      <Button x:Name="CloseButton"
              Grid.Column="5"
              Classes="windowControl close"
              Margin="0,0,10,0"
              Click="OnCloseClick"
              ToolTip.Tip="Close">
        <Path Width="11"
              Height="11"
              Stretch="None"
              Stroke="{DynamicResource Brush.TextSecondary}"
              StrokeThickness="1.2"
              Data="M 1,1 L 10,10 M 10,1 L 1,10" />
      </Button>
    </Grid>

    <ContentControl x:Name="LiveHost"
                    Grid.Row="1"
                    DataContext="{Binding Live}" />

    <Border Grid.Row="1"
            IsVisible="{Binding HasNotification}"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Width="350"
            Margin="22"
            Padding="15,13"
            CornerRadius="12"
            Background="{DynamicResource Brush.SurfaceElevated}"
            BorderBrush="{DynamicResource Brush.BorderStrong}"
            BorderThickness="1"
            BoxShadow="{DynamicResource Shadow.Floating}">
      <Grid ColumnDefinitions="*,34">
        <StackPanel Spacing="3">
          <TextBlock FontSize="12.5"
                     FontWeight="SemiBold"
                     Text="{Binding NotificationTitle}" />
          <TextBlock Classes="secondary"
                     FontSize="11.5"
                     MaxHeight="38"
                     Text="{Binding NotificationDetail}"
                     TextTrimming="CharacterEllipsis"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                Classes="icon quiet compact"
                Command="{Binding DismissNotificationCommand}">
          <Path Width="9"
                Height="9"
                Stroke="{DynamicResource Brush.TextMuted}"
                StrokeThickness="1.2"
                Data="M 1,1 L 8,8 M 8,1 L 1,8" />
        </Button>
      </Grid>
    </Border>

    <Grid x:Name="DrawerLayer"
          Grid.RowSpan="2"
          Panel.ZIndex="50"
          IsVisible="False"
          Opacity="0"
          ColumnDefinitions="*,Auto">
      <Border Grid.ColumnSpan="2"
              Background="#A6000000"
              PointerPressed="OnBackdropPointerPressed" />
      <Border x:Name="SettingsDrawer"
              Grid.Column="1"
              Width="570"
              Background="{DynamicResource Brush.Drawer}"
              BorderBrush="{DynamicResource Brush.BorderStrong}"
              BorderThickness="1,0,0,0"
              BoxShadow="-18 0 46 0 #7A000000">
        <Border.RenderTransform>
          <TranslateTransform X="570" />
        </Border.RenderTransform>
        <ContentControl x:Name="SettingsHost"
                        DataContext="{Binding Settings}" />
      </Border>
    </Grid>

    <Border Grid.RowSpan="2"
            ZIndex="100"
            Width="5"
            HorizontalAlignment="Left"
            Cursor="SizeWestEast"
            Background="Transparent"
            PointerPressed="OnResizeWest" />
    <Border Grid.RowSpan="2"
            ZIndex="100"
            Width="5"
            HorizontalAlignment="Right"
            Cursor="SizeWestEast"
            Background="Transparent"
            PointerPressed="OnResizeEast" />
    <Border Grid.RowSpan="2"
            ZIndex="100"
            Height="5"
            VerticalAlignment="Top"
            Cursor="SizeNorthSouth"
            Background="Transparent"
            PointerPressed="OnResizeNorth" />
    <Border Grid.RowSpan="2"
            ZIndex="100"
            Height="5"
            VerticalAlignment="Bottom"
            Cursor="SizeNorthSouth"
            Background="Transparent"
            PointerPressed="OnResizeSouth" />
    <Border Grid.RowSpan="2"
            ZIndex="101"
            Width="9"
            Height="9"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Cursor="TopLeftCorner"
            Background="Transparent"
            PointerPressed="OnResizeNorthWest" />
    <Border Grid.RowSpan="2"
            ZIndex="101"
            Width="9"
            Height="9"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Cursor="TopRightCorner"
            Background="Transparent"
            PointerPressed="OnResizeNorthEast" />
    <Border Grid.RowSpan="2"
            ZIndex="101"
            Width="9"
            Height="9"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Cursor="BottomLeftCorner"
            Background="Transparent"
            PointerPressed="OnResizeSouthWest" />
    <Border Grid.RowSpan="2"
            ZIndex="101"
            Width="9"
            Height="9"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Cursor="BottomRightCorner"
            Background="Transparent"
            PointerPressed="OnResizeSouthEast" />
    </Grid>
  </Border>
</Window>
